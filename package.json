{
  "name": "flagforge",
  "version": "1.0.0",
  "private": true,
  "description": "Feature Flag & Gradual Rollout Engine — control plane / data plane split, two-tier cache, deterministic bucketing, SSE streaming, AI rule compiler.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @flagforge/api db:generate",
    "db:migrate": "pnpm --filter @flagforge/api db:migrate",
    "db:seed": "pnpm --filter @flagforge/api db:seed",
    "db:push": "pnpm --filter @flagforge/api db:push",
    "up": "docker compose up --build",
    "down": "docker compose down -v",
    "demo": "node tools/demo-server.mjs",
    "preview": "node tools/preview.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
