# ──────────────────────────────────────────────────────────────────────────────
# FlagForge environment configuration
# Copy to `.env` for local (non-docker) development:  cp .env.example .env
# docker-compose reads this file automatically.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=flagforge
POSTGRES_PASSWORD=flagforge
POSTGRES_DB=flagforge
POSTGRES_PORT=5432
# Host-side connection string (used by the API running on the host)
DATABASE_URL=postgres://flagforge:flagforge@localhost:5432/flagforge
# Same, but reachable from inside docker-compose networking
DATABASE_URL_DOCKER=postgres://flagforge:flagforge@postgres:5432/flagforge

# ── Redis (L2 cache + Pub/Sub invalidation bus) ───────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_URL_DOCKER=redis://redis:6379

# ── API ───────────────────────────────────────────────────────────────────────
# API_PORT is an explicit override. Most managed hosts (Fly, Render, Railway,
# Cloud Run, Heroku) inject PORT instead, which is honoured as a fallback.
API_PORT=8080
API_HOST=0.0.0.0
# When set, control-plane writes require `Authorization: Bearer <token>`.
# Leave blank to run the zero-login public demo (writes are open).
ADMIN_API_TOKEN=
# Seed behaviour on boot: unset = seed only if the demo project is absent,
# `force` = wipe and re-seed, `false` = never seed.
SEED_DEMO=

# ── Observability + abuse protection ──────────────────────────────────────────
# Prometheus exposition at GET /metrics (guarded by ADMIN_API_TOKEN when set).
METRICS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
# Per SDK key, per window. Raise this before running the k6 load test.
RATE_LIMIT_DATA_MAX=20000
# Per client IP, per window.
RATE_LIMIT_CONTROL_MAX=120
# How long an outgoing SDK key keeps working after a rotation (seconds).
# 0 performs a hard cutover and will briefly break running clients.
SDK_KEY_ROTATION_GRACE_SECONDS=86400
# Comma-separated list of origins allowed to call the API / consume SSE
CORS_ORIGINS=http://localhost:3000
# TTL (seconds) for the Redis L2 flag-config cache before it expires defensively
L2_CACHE_TTL_SECONDS=300
# Logical cache namespace; bump to force a cold start across all instances
CACHE_NAMESPACE=flagforge

# ── Web ───────────────────────────────────────────────────────────────────────
WEB_PORT=3000
# Public URL the browser uses to reach the API (must be reachable from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-side (SSR / RSC) URL; inside docker this is the service name
API_INTERNAL_URL=http://localhost:8080

# ──────────────────────────────────────────────────────────────────────────────
# Optional AI Rule Compiler (OpenAI-compatible). Leave LLM_API_KEY blank to run
# the deterministic offline fallback parser — the demo works fully without it.
# Works with OpenAI, DeepSeek, Groq, Gemini (OpenAI-compat endpoint), etc.
# ──────────────────────────────────────────────────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000
